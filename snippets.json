  "macOS 64-bit (main)": {
    "prefix": "mac64-main",
    "body": [
      "default rel",
      "",
      "global _main",
      "extern _write",
      "",
      "section .data",
      "\tmsg db \"Hello macOS 64-bit from Arch Linux! (The Apple Way)\", 10",
      "\tlen equ $ - msg",
      "",
      "section .text",
      "_main:",
      "\tsub rsp, 8",
      "",
      "\tmov rdi, 1",
      "\tlea rsi, [msg]",
      "\tmov rdx, len",
      "\tcall _write",
      "",
      "\tadd rsp, 8",
      "\txor rax, rax",
      "\tret"
    ],
    "description": "Template for macOS 64-bit using main (Apple official method)"
  },

