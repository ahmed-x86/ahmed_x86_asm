  "Linux 64-bit (main)": {
    "prefix": "linux64-main",
    "body": [
      "section .data",
      "\tmsg db \"Hello from Arch Linux (64-bit Native) using main!\", 10",
      "\tlen equ $ - msg",
      "",
      "section .text",
      "\tglobal main",
      "",
      "main:",
      "\tmov rax, 1",
      "\tmov rdi, 1",
      "\tmov rsi, msg",
      "\tmov rdx, len",
      "\tsyscall",
      "",
      "\tmov rax, 60",
      "\txor rdi, rdi",
      "\tsyscall"
    ],
    "description": "Template for Linux 64-bit using main"
  },
