  "win_arm64_main": {
    "prefix": "win-arm64-main",
    "body": [
      ".data",
      "\tmsg: .ascii \"hi i use arch btw by win-arm64\\n\"",
      "\tlen = . - msg",
      "",
      ".bss",
      "\t.align 3",
      "\twritten: .space 8",
      "",
      ".text",
      "\t.global main",
      "",
      "main:",
      "\tstp x29, x30, [sp, #-32]!",
      "\tmov x29, sp",
      "",
      "\tmov x0, -11",
      "\tbl GetStdHandle",
      "",
      "\tldr x1, =msg",
      "\tldr x2, =len",
      "\tldr x3, =written",
      "\tmov x4, #0",
      "\tbl WriteConsoleA",
      "",
      "\tmov x0, #0",
      "\tldp x29, x30, [sp], #32",
      "\tret"
    ],
    "description": "Template for Windows ARM64 using main"
  },
