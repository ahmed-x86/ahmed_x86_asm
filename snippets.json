  "mac_arm64_main": {
    "prefix": "mac-arm64-main",
    "body": [
      ".data",
      "\tmsg: .ascii \"hi i use arch btw by mac-arm64\\n\"",
      "\tlen = . - msg",
      "",
      ".text",
      "\t.global _main",
      "\t.align 2",
      "",
      "_main:",
      "\tstp x29, x30, [sp, #-16]!",
      "\tmov x29, sp",
      "",
      "\tmov x0, #1",
      "\tadrp x1, msg@PAGE",
      "\tadd x1, x1, msg@PAGEOFF",
      "\tmov x2, len",
      "\tbl _write",
      "",
      "\tmov x0, #0",
      "\tldp x29, x30, [sp], #16",
      "\tret"
    ],
