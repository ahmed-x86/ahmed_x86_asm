      ".data",
      "\tmsg: .ascii \"Hello from ARM64 (main) on Arch Linux!\\n\"",
      "\tlen = . - msg",
      "",
      ".text",
      "\t.global main",
      "",
      "main:",
      "\tmov x8, #64",
      "\tmov x0, #1",
      "\tadrp x1, msg",
      "\tadd x1, x1, :lo12:msg",
      "\tmov x2, len",
      "\tsvc #0",
      "",
      "\tmov x8, #93",
      "\tmov x0, #0",
      "\tsvc #0"
    ],
    "description": "Template for Linux ARM64 using main (GNU Assembler)"
