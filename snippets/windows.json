  "Use the LOOP instruction to run 5 iterations": {
    "prefix": "Use_the_LOOP_instruction_to_run_5_iterations",
    "body": [
      "INCLUDE Irvine32.inc",
      ".data",
      ".code",
      "main PROC",
      "mov ecx, 5 ; loop 5 times",
      "mov eax, 0 ; accumulator",
      "mov ebx, 5 ; starts at 5",
      "myloop:",
      "add eax, ebx ; eax += ebx",
      "dec ebx ; ebx--",
      "loop myloop ; ecx--; jump if != 0",
      "; eax = 5+4+3+2+1 = 15",
      "call WriteInt",
      "exit",
      "main ENDP",
      "END main"
    ],
    "description": "Sum of 5 to 1 using loop"
  },
  "Declare variables: x = 50, y = 30.": {
    "prefix": "Declare_variables:_x_=_50,_y_=_30.",
    "body": [
      "INCLUDE Irvine32.inc",
      ".data",
      "x dd 50",
      "y dd 30",
      "msg1 db \"Result is 100 or more\", 0",
      "msg2 db \"Result is less than 100\", 0",
      ".code",
      "main PROC",
      "mov eax, x ; eax = 50",
      "mov ebx, y ; ebx = 30",
      "add eax, ebx ; eax = 80",
      "cmp eax, 100",
      "jge geq ; jump if eax >= 100",
      "mov edx, offset msg2",
      "call WriteString",
      "jmp done",
      "geq:",
      "mov edx, offset msg1",
      "call WriteString",
      "done:",
      "call DumpRegs",
      "exit",
      "main ENDP",
      "END main"
    ],
    "description": "Add two variables and jump based on condition"
  }
