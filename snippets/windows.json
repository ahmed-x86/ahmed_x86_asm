{
  "Win64 Standalone (main)": {
    "prefix": "win64-std-main",
    "body": [
      "extern GetStdHandle",
      "extern WriteFile",
      "extern ExitProcess",
      "",
      "global main",
      "",
      "section .data",
      "\tmsg db \"3. Task 8 Success: Win64 Standalone is running beautifully on Arch!\", 10",
      "\tmsg_len equ $ - msg",
      "",
      "section .bss",
      "\twritten resq 1",
      "",
      "section .text",
      "main:",
      "\tsub rsp, 40",
      "",
      "\tmov rcx, -11",
      "\tcall GetStdHandle",
      "",
      "\tmov rcx, rax",
      "\tlea rdx, [rel msg]",
      "\tmov r8, msg_len",
      "\tlea r9, [rel written]",
      "\tmov qword [rsp+32], 0",
      "\tcall WriteFile",
      "",
      "\txor rcx, rcx",
      "\tcall ExitProcess"
    ],
    "description": "Win64 Standalone template using main"
  },
  "Win64 Standalone (_start)": {
    "prefix": "win64-std-start",
    "body": [
      "section .data",
      "\tmsg db 'hi i use arch btw by win64 from windows10pro', 10, 0",
      "\tmsg_len equ $-msg",
      "",
      "section .bss",
      "\twritten resq 1",
      "",
      "section .text",
      "\tglobal _start",
      "\textern GetStdHandle",
      "\textern WriteConsoleA",
      "\textern ExitProcess",
      "",
      "_start:",
      "\tsub rsp, 40",
      "",
      "\tmov rcx, -11",
      "\tcall GetStdHandle",
      "",
      "\tmov rcx, rax",
      "\tmov rdx, msg",
      "\tmov r8, msg_len",
      "\tmov r9, written",
      "\tmov qword [rsp + 32], 0",
      "\tcall WriteConsoleA",
      "",
      "\tmov rcx, 0",
      "\tcall ExitProcess"
    ],
    "description": "Win64 Standalone template using _start"
  },
  "Win32 Standalone (main)": {
    "prefix": "win32-std-main",
    "body": [
      "extern _GetStdHandle@4",
      "extern _WriteFile@20",
      "extern _ExitProcess@4",
      "",
      "global _main",
      "",
      "section .data",
      "\tmsg db \"2. Task 7 Success: Win32 Standalone works directly via Windows API!\", 10",
      "\tmsg_len equ $ - msg",
      "",
      "section .bss",
      "\twritten resd 1",
      "",
      "section .text",
      "_main:",
      "\tpush -11",
      "\tcall _GetStdHandle@4",
      "",
      "\tpush 0",
      "\tpush written",
      "\tpush msg_len",
      "\tpush msg",
      "\tpush eax",
      "\tcall _WriteFile@20",
      "",
      "\tpush 0",
      "\tcall _ExitProcess@4"
    ],
    "description": "Win32 Standalone template using main and Windows API"
  },
  "Win32 Standalone (_start)": {
    "prefix": "win32-std-start",
    "body": [
      "section .data",
      "\tmsg db 'hi i use arch btw from win32 windows 10 pro', 10, 0",
      "\tmsg_len equ $-msg",
      "",
      "section .bss",
      "\twritten resd 1",
      "",
      "section .text",
      "\tglobal _start",
      "\textern _GetStdHandle@4",
      "\textern _WriteConsoleA@20",
      "\textern _ExitProcess@4",
      "",
      "_start:",
      "\tpush -11",
      "\tcall _GetStdHandle@4",
      "",
      "\tpush 0",
      "\tpush written",
      "\tpush msg_len",
      "\tpush msg",
      "\tpush eax",
      "\tcall _WriteConsoleA@20",
      "",
      "\tpush 0",
      "\tcall _ExitProcess@4"
    ],
    "description": "Win32 Standalone template using _start"
  },
  "Win32 Irvine (Task 6)": {
    "prefix": "win32-irvine-main",
    "body": [
      "INCLUDE Irvine32.inc",
      "",
      ".data",
      "\tmsg BYTE \"1. Task 6 Success: Win32 Irvine with main is working perfectly!\", 0",
      "",
      ".code",
      "main PROC",
      "\tmov edx, OFFSET msg",
      "\tcall WriteString",
      "\tcall Crlf",
      "\texit",
      "main ENDP",
      "END main"
    ],
    "description": "Win32 Irvine template with main"
  },
