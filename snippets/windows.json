  "Declare two variables: val1 = 12, val2 = 4": {
    "prefix": "Declare_two_variables:_val1_=_12,_val2_=_4",
    "body": [
      "INCLUDE Irvine32.inc",
      ".data",
      "val1 dd 12",
      "val2 dd 4",
      ".code",
      "main PROC",
      "mov eax, val1 ; eax = 12",
      "mov ebx, val2 ; ebx = 4",
      "add eax, ebx ; eax = 16",
      "imul eax, 3 ; eax = 48",
      "sub eax, 2 ; eax = 46",
      "inc eax ; eax = 47",
      "call DumpRegs",
      "exit",
      "main ENDP",
      "END main"
    ],
    "description": "Math operations with two variables"
  },
  "Welcome to Assembly Language!": {
    "prefix": "Welcome_to_Assembly_Language!",
    "body": [
      "INCLUDE Irvine32.inc",
      ".data",
      "msg db \"Welcome to Assembly Language!\", 0",
      ".code",
      "main PROC",
      "mov edx, offset msg",
      "call WriteString",
      "call DumpRegs",
      "exit",
      "main ENDP",
      "END main"
    ],
    "description": "Print a welcome message"
  },
  "Calculate the sum of integers from 1 to 10": {
    "prefix": "Calculate_the_sum_of_integers_from_1_to_10_using_the_LOOP_instruction",
    "body": [
      "INCLUDE Irvine32.inc",
      ".data",
      ".code",
      "main PROC",
      "mov ecx, 10 ; loop counter",
      "mov eax, 0 ; sum accumulator",
      "mov ebx, 1 ; current number",
      "myloop:",
      "add eax, ebx ; sum += current",
      "inc ebx ; next number",
      "loop myloop ; ecx-- and jump if not zero",
      "call WriteInt ; print sum (eax = 55)",
      "exit",
      "main ENDP",
      "END main"
    ],
    "description": "Sum using LOOP instruction"
  },
  "Declare two variables: num1 = 25, num2 = 40": {
    "prefix": "Declare_two_variables:_num1_=_25,_num2_=_40",
    "body": [
      "INCLUDE Irvine32.inc",
      ".data",
      "num1 dd 25",
      "num2 dd 40",
      "msg1 db \"First is Greater\", 0",
      "msg2 db \"Second is Greater\", 0",
      "msg3 db \"Both are Equal\", 0",
      ".code",
      "main PROC",
      "mov eax, num1",
      "mov ebx, num2",
      "cmp eax, ebx",
      "jg first",
      "jl second",
      "jmp equal",
      "first:",
      "mov edx, offset msg1",
      "call WriteString",
      "exit",
      "second:",
      "mov edx, offset msg2",
      "call WriteString",
      "exit",
      "equal:",
      "mov edx, offset msg3",
      "call WriteString",
      "exit",
      "main ENDP",
      "END main"
    ],
    "description": "Compare two numbers and print result"
  },
  "Declare two variables: a = 100, b = 200": {
    "prefix": "Declare_two_variables:_a_=_100,_b_=_200",
    "body": [
      "INCLUDE Irvine32.inc",
      ".data",
      "a dd 100",
      "b dd 200",
      ".code",
      "main PROC",
      "mov eax, a ; eax = 100",
      "mov ebx, b ; ebx = 200",
      "mov edx, eax ; edx = 100 (temp)",
      "mov eax, ebx ; eax = 200",
      "mov ebx, edx ; ebx = 100",
      "call DumpRegs",
      "exit",
      "main ENDP",
      "END main"
    ],
    "description": "Swap values of two variables"
  },
  "Use a conditional loop (CMP + JNE)": {
    "prefix": "Use_a_conditional_loop_(CMP_+_JNE)_to_count_from_1_to_5.",
    "body": [
      "INCLUDE Irvine32.inc",
      ".data",
      ".code",
      "main PROC",
      "mov ecx, 5 ; countdown counter",
      "mov ebx, 0 ; accumulator",
      "myloop:",
      "add ebx, 1 ; ebx++",
      "dec ecx ; ecx--",
      "cmp ecx, 0",
      "jne myloop ; repeat if ecx != 0",
      "call DumpRegs",
      "exit",
      "main ENDP",
      "END main"
    ],
    "description": "Conditional loop to count from 1 to 5"
  },
  "Declare a variable num = 7": {
    "prefix": "Declare_a_variable_num_=_7",
